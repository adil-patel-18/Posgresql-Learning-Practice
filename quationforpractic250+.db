CREATE TABLE students (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    age INT,
    city VARCHAR(50),
    marks INT,
    email VARCHAR(100)
);
--                                      INSERT

--Q1.Insert one student into the students table.
--Q2.Insert 5 students into the table.
--Q3.Insert a student with only name, age, and city.
--Q4.Insert a student whose city is Pune.
--Q5.Insert 3 students with different marks.

INSERT INTO students (id, name, age, city, marks, email)
VALUES
(1, 'Adil', 21, 'Pune', 85, 'adil@gmail.com'),
(2, 'Rahul', 22, 'Mumbai', 72, 'rahul@gmail.com'),
