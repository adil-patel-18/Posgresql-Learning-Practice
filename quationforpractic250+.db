(6, 'Rohit', 23, 'Delhi', 38, 'rohit@gmail.com'),
(7, 'Sneha', 20, 'Pune', 76, 'sneha@gmail.com'),
(8, 'Vikas', 24, 'Nashik', 45, 'vikas@gmail.com'),
