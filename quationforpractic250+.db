--                                                                            ALTER TABLE – Practice Questions

--78. Add a new column `phone` to the students table.
alter table students add column phone int;

--79. Add a column `gender`.
alter table students add gender char;

--80. Change the datatype of `phone`.
alter table students alter column phone set data type float;

--81. Rename column `name` to `student_name`.
alter table students rename column name to stud_name;

--82. Rename column `city` to `student_city`.
alter table students rename column city to stud_city;

--83. Rename the table `students` to `student_details`.
alter table students rename to student_details;

--84. Delete the `phone` column.
alter table student_details drop column phone;

--85. Add a default value to the `city` column.
alter table student_details alter column city add constraint default 'pune';

--86. Add a `NOT NULL` constraint to `name`.
alter table student_details alter column name add data type not null;

87. Add a `UNIQUE` constraint to `email`.

